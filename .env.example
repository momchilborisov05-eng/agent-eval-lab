# Copy this file to ".env" and add your Claude API key from https://console.anthropic.com
# Not needed for the offline demo (python -m evallab demo).
ANTHROPIC_API_KEY=

# Optional: claude-opus-5-5 (default) or claude-sonnet-5-5 (faster, cheaper)
CLAUDE_MODEL=claude-opus-5-5

# Optional: where runs are stored (default: eval_lab.db in the project folder)
# EVAL_LAB_DB=eval_lab.db
